{
  "name": "@colox/react",
  "version": "0.0.0",
  "description": "Colox React component library",
  "type": "module",
  "license": "MIT",
  "sideEffects": [
    "**/*.css",
    "**/*.scss"
  ],
  "files": [
    "dist",
    "src/styles"
  ],
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/es/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/es/index.js",
      "require": "./dist/cjs/index.cjs"
    },
    "./style.css": "./dist/style.css",
    "./themes/light.css": "./dist/themes/light.css",
    "./themes/*": "./dist/themes/*",
    "./styles/*": "./src/styles/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "pnpm run tokens:sync && vite build && pnpm run emit:themes",
    "build:tokens": "pnpm run tokens:sync && pnpm run emit:themes",
    "emit:themes": "style-dictionary build --config sd.config.mjs && style-dictionary build --config sd-dark.config.mjs",
    "tokens:sync": "node scripts/figma-to-tokens.mjs",
    "build:watch": "pnpm run tokens:sync && vite build --watch",
    "typecheck": "pnpm run tokens:sync && tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@storybook/react": "^8.6.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sass": "^1.83.0",
    "style-dictionary": "^4.4.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vite-plugin-dts": "^4.5.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1"
  }
}
