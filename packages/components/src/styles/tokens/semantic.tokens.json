{
  "colox": {
    "alpha": {
      "hover": { "$value": "15%", "$type": "other" },
      "focus": { "$value": "30%", "$type": "other" },
      "disabled": { "$value": "10%", "$type": "other" },
      "placeholder": { "$value": "50%", "$type": "other" }
    },
    "color": {
      "bg": {
        "default": { "$value": "{colox.palette.gray.50}", "$type": "color" },
        "subtle": { "$value": "{colox.palette.gray.100}", "$type": "color" },
        "muted": { "$value": "{colox.palette.gray.200}", "$type": "color" },
        "overlay": { "$value": "{colox.palette.gray.50}", "$type": "color" }
      },
      "text": {
        "primary": { "$value": "{colox.palette.gray.900}", "$type": "color" },
        "secondary": { "$value": "{colox.palette.gray.600}", "$type": "color" },
        "placeholder": {
          "$value": "color-mix(in srgb, {colox.palette.gray.900} {colox.alpha.placeholder}, transparent)",
          "$type": "color"
        },
        "disabled": { "$value": "{colox.palette.gray.500}", "$type": "color" },
        "inverse": { "$value": "{colox.palette.gray.50}", "$type": "color" }
      },
      "border": {
        "subtle": { "$value": "{colox.palette.gray.200}", "$type": "color" },
        "default": { "$value": "{colox.palette.gray.300}", "$type": "color" },
        "strong": { "$value": "{colox.palette.gray.500}", "$type": "color" }
      },
      "action": {
        "primary": { "$value": "{colox.palette.indigo.500}", "$type": "color" },
        "primaryHover": {
          "$value": "color-mix(in srgb, {colox.palette.indigo.500} 85%, #000)",
          "$type": "color"
        },
        "primaryActive": {
          "$value": "color-mix(in srgb, {colox.palette.indigo.500} 75%, #000)",
          "$type": "color"
        },
        "subtleHover": {
          "$value": "color-mix(in srgb, {colox.palette.indigo.500} {colox.alpha.hover}, transparent)",
          "$type": "color"
        }
      },
      "focus": {
        "ring": {
          "$value": "color-mix(in srgb, {colox.palette.indigo.500} {colox.alpha.focus}, transparent)",
          "$type": "color"
        }
      },
      "status": {
        "success": {
          "fill": { "$value": "{colox.palette.green.800}", "$type": "color" },
          "subtle": { "$value": "{colox.palette.green.50}", "$type": "color" },
          "text": { "$value": "{colox.palette.green.900}", "$type": "color" }
        },
        "warning": {
          "fill": { "$value": "{colox.palette.orange.600}", "$type": "color" },
          "subtle": { "$value": "{colox.palette.orange.50}", "$type": "color" },
          "text": { "$value": "{colox.palette.orange.900}", "$type": "color" }
        },
        "danger": {
          "fill": { "$value": "{colox.palette.red.600}", "$type": "color" },
          "subtle": { "$value": "{colox.palette.red.50}", "$type": "color" },
          "text": { "$value": "{colox.palette.red.900}", "$type": "color" }
        },
        "info": {
          "fill": { "$value": "{colox.palette.blue.600}", "$type": "color" },
          "subtle": { "$value": "{colox.palette.blue.50}", "$type": "color" },
          "text": { "$value": "{colox.palette.blue.900}", "$type": "color" }
        }
      }
    }
  }
}
