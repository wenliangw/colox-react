{
  "colox": {
    "color": {
      "text": {
        "solid": { "$value": "#E8E8E8", "$type": "color" },
        "muted": { "$value": "#A3A3A3", "$type": "color" },
        "subtle": { "$value": "#707070", "$type": "color" },
        "disabled": { "$value": "#5F5F5F", "$type": "color" },
        "inverse": { "$value": "#191919", "$type": "color" },
        "info": { "$value": "#A1C5F7", "$type": "color" },
        "error": { "$value": "#F7A1A9", "$type": "color" },
        "warning": { "$value": "#F7C9A1", "$type": "color" },
        "success": { "$value": "#A1F7CF", "$type": "color" }
      },
      "border": {
        "solid": { "$value": "#3D3D3D", "$type": "color" },
        "muted": { "$value": "#333333", "$type": "color" },
        "subtle": { "$value": "#2A2A2A", "$type": "color" },
        "disabled": { "$value": "#333333", "$type": "color" },
        "info": { "$value": "#307DE8", "$type": "color" },
        "error": { "$value": "#E83043", "$type": "color" },
        "warning": { "$value": "#E88630", "$type": "color" },
        "success": { "$value": "#30E892", "$type": "color" }
      },
      "bg": {
        "solid": { "$value": "#191919", "$type": "color" },
        "muted": { "$value": "#262626", "$type": "color" },
        "subtle": { "$value": "#1F1F1F", "$type": "color" },
        "overlay": { "$value": "#242424", "$type": "color" },
        "disabled": { "$value": "#242424", "$type": "color" },
        "inverse": { "$value": "#FFFFFF", "$type": "color" },
        "info": { "$value": "#1C3C69", "$type": "color" },
        "error": { "$value": "#691C24", "$type": "color" },
        "warning": { "$value": "#69401C", "$type": "color" },
        "success": { "$value": "#1C6945", "$type": "color" }
      },
      "indigo": {
        "subtle": { "$value": "#15124E", "$type": "color" },
        "hover": {
          "$value": "color-mix(in srgb, var(--colox-color-indigo-solid) 85%, #FFFFFF)",
          "$type": "color"
        },
        "active": {
          "$value": "color-mix(in srgb, var(--colox-color-indigo-solid) 75%, #FFFFFF)",
          "$type": "color"
        }
      },
      "gray": {
        "muted": { "$value": "#383838", "$type": "color" },
        "subtle": { "$value": "#2A2A2A", "$type": "color" },
        "hover": {
          "$value": "color-mix(in srgb, var(--colox-color-gray-solid) 85%, #FFFFFF)",
          "$type": "color"
        },
        "active": {
          "$value": "color-mix(in srgb, var(--colox-color-gray-solid) 75%, #FFFFFF)",
          "$type": "color"
        }
      },
      "red": {
        "subtle": { "$value": "#691C24", "$type": "color" },
        "hover": {
          "$value": "color-mix(in srgb, var(--colox-color-red-solid) 85%, #FFFFFF)",
          "$type": "color"
        },
        "active": {
          "$value": "color-mix(in srgb, var(--colox-color-red-solid) 75%, #FFFFFF)",
          "$type": "color"
        }
      },
      "green": {
        "subtle": { "$value": "#1C6945", "$type": "color" }
      },
      "orange": {
        "subtle": { "$value": "#69401C", "$type": "color" }
      },
      "blue": {
        "subtle": { "$value": "#1C3C69", "$type": "color" }
      }
    }
  }
}
