{
  "name": "@colox/mcp",
  "version": "0.0.0",
  "description": "Colox MCP server: serves the @colox/wiki AI doctrine over local stdio.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/colox/colox-react.git",
    "directory": "packages/mcp"
  },
  "bin": {
    "@colox/mcp": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@colox/wiki": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
