{
  "colox": {
    "shadow": {
      "sm": {
        "$value": "0 1px 2px rgba(0, 0, 0, 0.35), 0 1px 3px rgba(0, 0, 0, 0.50)",
        "$type": "shadow"
      },
      "md": {
        "$value": "0 4px 6px -1px rgba(0, 0, 0, 0.50), 0 2px 4px -2px rgba(0, 0, 0, 0.40)",
        "$type": "shadow"
      },
      "lg": {
        "$value": "0 10px 15px -3px rgba(0, 0, 0, 0.60), 0 4px 6px -4px rgba(0, 0, 0, 0.50)",
        "$type": "shadow"
      },
      "inset": {
        "$value": "0 1px 3px rgba(0, 0, 0, 0.50)",
        "$type": "shadow"
      }
    }
  }
}
