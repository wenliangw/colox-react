{
  "name": "@colox/theme",
  "version": "0.0.0",
  "description": "Colox design & theme system: tokens, theme CSS, theme compiler CLI and theme runtime",
  "type": "module",
  "license": "MIT",
  "sideEffects": [
    "**/*.css",
    "**/*.scss"
  ],
  "files": [
    "dist",
    "src/styles",
    "cli",
    "schemas",
    "config"
  ],
  "bin": {
    "colox": "./cli/colox.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/es/index.js",
      "require": "./dist/cjs/index.cjs"
    },
    "./index.css": "./dist/index.css",
    "./themes/palette.css": "./dist/themes/palette.css",
    "./themes/light.css": "./dist/themes/light.css",
    "./themes/*": "./dist/themes/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "pnpm run tokens:sync && pnpm run emit:themes && vite build",
    "build:tokens": "pnpm run tokens:sync && pnpm run emit:themes",
    "emit:themes": "style-dictionary build --config sd-palette.config.mjs && style-dictionary build --config sd.config.mjs && style-dictionary build --config sd-dark.config.mjs && node scripts/emit-cli-data.mjs && node scripts/emit-index-css.mjs",
    "tokens:sync": "node scripts/figma-to-tokens.mjs",
    "typecheck": "pnpm run tokens:sync && tsc --noEmit -p tsconfig.json",
    "pretest": "pnpm run build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@testing-library/react": "^16.1.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "style-dictionary": "^4.4.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vite-plugin-dts": "^4.5.0",
    "vitest": "^3.0.0"
  }
}
