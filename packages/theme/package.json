{
  "name": "@colox/theme",
  "version": "0.0.0",
  "description": "Colox theme runtime (ColoxTheme provider + responsive system) and the packaged stock theme CSS",
  "type": "module",
  "license": "MIT",
  "sideEffects": [
    "**/*.css",
    "**/*.scss"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/es/index.js",
      "require": "./dist/cjs/index.cjs"
    },
    "./index.css": "./dist/index.css",
    "./themes/palette.css": "./dist/themes/palette.css",
    "./themes/light.css": "./dist/themes/light.css",
    "./themes/*": "./dist/themes/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "pnpm run build:css && node scripts/sync-breakpoints.mjs && pnpm run clean:js && vite build",
    "build:css": "colox theme build",
    "clean:js": "node scripts/clean-dist.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "pretest": "pnpm run build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@colox/theme-builder": "workspace:*",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vite-plugin-dts": "^4.5.0",
    "vitest": "^3.0.0"
  }
}
