# database
*.db-shm
*.db-wal

# dependencies
node_modules
.pnpm-store

# build outputs
dist
build
coverage
storybook-static
.docusaurus
*.tsbuildinfo

# generated token sources (regenerated from styles/meta via the
# @colox/theme-builder builtin pipeline)
packages/theme-builder/src/styles/tokens/*.tokens.json
!packages/theme-builder/src/styles/tokens/semantic.derived.tokens.json
!packages/theme-builder/src/styles/tokens/semantic.derived.dark.tokens.json
!packages/theme-builder/src/styles/tokens/semantic.brand.tokens.json
!packages/theme-builder/src/styles/tokens/semantic.brand.dark.tokens.json
!packages/theme-builder/src/styles/tokens/palette.brand.tokens.json
!packages/theme-builder/src/styles/tokens/base.tokens.json
!packages/theme-builder/src/styles/tokens/semantic.shadow.tokens.json
!packages/theme-builder/src/styles/tokens/semantic.shadow.dark.tokens.json
# runtime token artifacts (emitted by the builder per the theme build
# contract's `runtime` block; file names are builder decisions)
packages/theme/src/styles/tokens/

# logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# editor / os
.DS_Store
Thumbs.db
.idea
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# env
.env
