{
  "name": "@colox/docs",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @colox/react build && concurrently -k -n lib,docs \"pnpm --filter @colox/react build:watch\" \"docusaurus start\"",
    "build": "pnpm --filter @colox/react build && docusaurus build",
    "serve": "docusaurus serve",
    "clear": "docusaurus clear",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@colox/react": "workspace:*",
    "@docusaurus/core": "^3.7.0",
    "@docusaurus/preset-classic": "^3.7.0",
    "@mdx-js/react": "^3.1.0",
    "clsx": "^2.1.1",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "^3.7.0",
    "@docusaurus/tsconfig": "^3.7.0",
    "@docusaurus/types": "^3.7.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "concurrently": "^9.1.2",
    "sass": "^1.83.0",
    "sass-loader": "^14.2.1",
    "typescript": "^5.7.0"
  }
}
