{
  "extends": "@docusaurus/tsconfig",
  "compilerOptions": {
    "jsx": "react-jsx",
    "paths": {
      "@site/*": ["./*"],
      "@colox/react": ["../../packages/components/src/index.ts"],
      "@colox/cdk/*": ["../../packages/components/src/cdk/*"]
    }
  },
  "include": ["src/**/*", "docs/**/*", "*.ts", "*.tsx"],
  "exclude": [".docusaurus", "build", "node_modules"]
}
